# Production uchun .env faylida quyidagi o'zgaruvchilarni o'rnating.
# Bu fayl faqat namuna — haqiqiy qiymatlarni .env ga yozing (va .env ni git ga commit qilmang).

# PostgreSQL (majburiy)
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DATABASE?schema=public"

# OpenAI — AI xulosa uchun (majburiy, agar AI xulosa ishlatilsa)
OPENAI_API_KEY="sk-..."
# Agar serveringiz OpenAI tomonidan bloklangan regionda bo'lsa (403 unsupported_country),
# proxy yoki boshqa endpoint ishlating (OpenAI API bilan mos bo'lgan URL, /v1 siz):
# OPENAI_BASE_URL="https://your-proxy.example.com"

# Eskiz.uz — SMS (OTP) uchun
ESKIZ_EMAIL=""
ESKIZ_PASSWORD=""
# ESKIZ_FROM="4546"
# ESKIZ_CALLBACK_URL=""

# Click — to'lov
CLICK_MERCHANT_ID=""
CLICK_SERVICE_ID=""
CLICK_SECRET_KEY=""
CLICK_MERCHANT_USER_ID=""

# To'lov summasi (so'm). Bo'lmasa default 1000
# PAYMENT_AMOUNT=1000

# Production uchun .env faylida quyidagi o'zgaruvchilarni o'rnating.
# Bu fayl faqat namuna — haqiqiy qiymatlarni .env ga yozing (va .env ni git ga commit qilmang).

# PostgreSQL (majburiy)
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DATABASE?schema=public"

# Eskiz.uz — SMS (OTP) uchun
ESKIZ_EMAIL=""
ESKIZ_PASSWORD=""
# ESKIZ_FROM="4546"
# ESKIZ_CALLBACK_URL=""

# App Store / Google Play tekshiruvchilari uchun demo akkaunt (ixtiyoriy).
# Shu raqamga SMS yuborilmaydi — kod sifatida REVIEW_OTP_CODE qabul qilinadi.
# REVIEW_PHONE="+998XXXXXXXXX"
# REVIEW_OTP_CODE="XXXXXX"  # 4 yoki 6 xonali

# Mobil push (Firebase Cloud Messaging): service account JSON fayl matni bitta qatorda.
# Yoki uning o'rniga GOOGLE_APPLICATION_CREDENTIALS=/yo'l/serviceAccount.json
FIREBASE_SERVICE_ACCOUNT=

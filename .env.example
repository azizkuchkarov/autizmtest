# Production uchun .env faylida quyidagi o'zgaruvchilarni o'rnating.
# Bu fayl faqat namuna — haqiqiy qiymatlarni .env ga yozing (va .env ni git ga commit qilmang).

# PostgreSQL (majburiy)
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DATABASE?schema=public"

# Eskiz.uz — SMS (OTP) uchun
ESKIZ_EMAIL=""
ESKIZ_PASSWORD=""
# ESKIZ_FROM="4546"
# ESKIZ_CALLBACK_URL=""

# App Store / Google Play tekshiruvchilari uchun demo akkaunt (ixtiyoriy).
# Shu raqamga SMS yuborilmaydi — kod sifatida REVIEW_OTP_CODE qabul qilinadi.
# REVIEW_PHONE="+998XXXXXXXXX"
# REVIEW_OTP_CODE="XXXXXX"  # 4 yoki 6 xonali

# Mobil push (Firebase Cloud Messaging): service account JSON fayl matni bitta qatorda.
# Yoki uning o'rniga GOOGLE_APPLICATION_CREDENTIALS=/yo'l/serviceAccount.json
FIREBASE_SERVICE_ACCOUNT=

# To'lov (Click) — skrining natijasi to'lovdan keyin ochiladi
CLICK_MERCHANT_ID=""
CLICK_SERVICE_ID=""
CLICK_SECRET_KEY=""
CLICK_MERCHANT_USER_ID=""
# Narx, so'm (default 1000)
# PAYMENT_AMOUNT=99000
# Click merchant panelida: Prepare URL = https://autizmtest.uz/api/payment/click/prepare
#                          Complete URL = https://autizmtest.uz/api/payment/click/complete

# To'lov UI tugmasi: show | hide (default hide).
# hide — to'lov faqat UI dan yashiriladi, natijalar bepul ochiladi; Click endpointlari ishlayveradi.
PAYMENTS_UI=hide
# Mobil ilova: shu versiyadan past buildlarda to'lov ko'rinmaydi (ixtiyoriy)
# PAYMENTS_MIN_VERSION=1.1.0
# Mobil ilova: shu versiyalarda to'lov yashiriladi, masalan App Store review'dagi build (vergul bilan)
# PAYMENTS_HIDE_VERSIONS=1.2.0
# Click qaytish havolasi uchun sayt manzili (bo'lmasa so'rov hostidan olinadi)
# NEXT_PUBLIC_APP_URL=https://autizmtest.uz
